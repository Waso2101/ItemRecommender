<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ItemRecommender</AssemblyName>
    <RootNamespace>ItemRecommender</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>CS0618</NoWarn>
    <!-- Pfade anpassen, falls das Spiel oder das Profil woanders liegt -->
    <GameDir Condition="'$(GameDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2</GameDir>
    <ProfileDir Condition="'$(ProfileDir)'==''">$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\aaaaaaaaaa</ProfileDir>
    <Managed>$(GameDir)\Risk of Rain 2_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(Managed)\RoR2.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Managed)\com.unity.multiplayer-hlapi.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Addressables.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(Managed)\HGCSharpUtils.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ProfileDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(ProfileDir)\BepInEx\core\0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="builds.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Nach dem Build: Thunderstore-Paket bauen und ins Testprofil kopieren
       (gleicher Ordner, den r2modman beim Import anlegt) -->
  <Target Name="PackageAndDeploy" AfterTargets="Build">
    <PropertyGroup>
      <PkgDir>$(MSBuildProjectDirectory)\package\build</PkgDir>
      <ModFolder>$(ProfileDir)\BepInEx\plugins\Waso-ItemRecommender</ModFolder>
    </PropertyGroup>
    <RemoveDir Directories="$(PkgDir)" />
    <Copy SourceFiles="$(TargetPath);$(OutDir)builds.txt;package\manifest.json;package\icon.png;README.md;CHANGELOG.md" DestinationFolder="$(PkgDir)" />
    <ZipDirectory SourceDirectory="$(PkgDir)" DestinationFile="$(MSBuildProjectDirectory)\package\Waso-ItemRecommender.zip" Overwrite="true" />
    <Copy Condition="Exists('$(ModFolder)')" SourceFiles="$(TargetPath);$(OutDir)builds.txt;package\manifest.json;package\icon.png;README.md;CHANGELOG.md" DestinationFolder="$(ModFolder)" />
    <Exec Condition="Exists('$(ModFolder)')" Command="python &quot;$(MSBuildProjectDirectory)	ools\sync_r2modman.py&quot; &quot;$(ProfileDir)&quot; &quot;$(MSBuildProjectDirectory)\package\manifest.json&quot;" ContinueOnError="true" />
  </Target>
</Project>
